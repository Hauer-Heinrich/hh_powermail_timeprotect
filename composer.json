{
    "type": "typo3-cms-extension",
    "name": "hauerheinrich/hh-powermail-timeprotect",
    "description": "Powermail time protection - for spam prevention.",
    "keywords": [ "TYPO3 CMS", "TYPO3", "theme", "distribution", "extension" ],
    "homepage": "https://www.hauer-heinrich.de",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Christian Hackl",
            "homepage": "https://www.hauer-heinrich.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Hauer-Heinrich/hh_powermail_timeprotect/issues",
        "source": "https://github.com/Hauer-Heinrich/hh_powermail_timeprotect",
        "docs": "https://github.com/Hauer-Heinrich/hh_powermail_timeprotect/blob/master/README.md"
    },
    "funding": [
        {
            "type": "paypal",
            "url": "https://www.paypal.com/paypalme/hauerheinrich"
        }
    ],
    "require": {
        "typo3/cms-core": "^13.4.0",
        "typo3/cms-extbase": "^13.4.0",
        "typo3/cms-fluid": "^13.4.0",
        "in2code/powermail": "^13.0.0"
    },
    "autoload": {
        "psr-4": {
            "HauerHeinrich\\HhPowermailTimeprotect\\": "Classes"
        }
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/Web",
            "extension-key": "hh_powermail_timeprotect",
            "version": "3.1.0",
            "Package": {
                "providesPackages": []
            }
        }
    },
    "archive": {
        "exclude": [
            "/.git/",
            "/.github/",
            "/.idea/",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore",
            "/.bundle.config.json",
            "/.bundle.config.json.example",
            "/.bundle.mjs",
            "/package.json",
            "/package-lock.json",
            "/*.code-workspace",
            "**/node_modules/",
            "**/*.zip"
        ]
    }
}
